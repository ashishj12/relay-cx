# Synthetic local environment. Never commit .env.
APP_MODE=REVIEWER
APP_HOST=127.0.0.1
APP_PORT=8080
MOCK_HOST=127.0.0.1
MOCK_PORT=8090
ENTERPRISE_API_BASE_URL=http://127.0.0.1:8090
DATABASE_PATH=.local/data/relay.sqlite
STRUCTURED_LOG_PATH=.local/data/events.jsonl
REQUEST_TIMEOUT=2
MAX_RETRIES=1
AI_TIMEOUT=40
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:3000
MOCK_ALLOW_FAILURES=true

# Optional Google Cloud setup. Leave blank for local use.
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1
RELAY_API_IMAGE=
RELAY_WEB_IMAGE=
# Only the synthetic enterprise process uses this path; Compose sets its own volume path.
MOCK_DATABASE_PATH=data/enterprise.sqlite
